rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Classements (lisibles par TOUS, écrits seulement par leur auteur)
    // ============================================================

    // Jeu principal « Devine le nombre »
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Mini-jeu « Mémory »
    match /memory_scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}